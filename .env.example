# =============================================================================
# Ford VIN Share API, variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env real.
# =============================================================================

# Servidor
SERVER_PORT=8080

# Banco de dados (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/vinshare
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# JWT (OBRIGATÓRIO, >= 64 caracteres)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7

# CORS (separar por vírgula)
CORS_ORIGINS=http://localhost:8081,exp://localhost:19000

# Criptografia do CPF (OBRIGATÓRIAS)
# CPF_AES_KEY: 32 bytes em Base64 -> openssl rand -base64 32
# CPF_HMAC_KEY: >= 32 caracteres -> python -c "import secrets; print(secrets.token_urlsafe(48))"
CPF_AES_KEY=
CPF_HMAC_KEY=

# Seed de dados sintéticos (só em ambiente de demonstração)
SEED_ENABLED=false
# Obrigatória quando SEED_ENABLED=true (mínimo 12 caracteres)
SEED_DEFAULT_PASSWORD=

# Notificações proativas (jobs agendados)
NOTIFICATIONS_ENABLED=false

# IP do cliente: número de proxies confiáveis na frente da API (Azure App Service = 1; local = 0)
CLIENT_IP_TRUSTED_HOPS=0

# Integrações externas (vazias = modo simulado)
GEMINI_API_KEY=
EXPO_ACCESS_TOKEN=

# Política de retenção
RETENTION_ENABLED=false
RETENTION_CHAT_DAYS=90
RETENTION_AUDIT_DAYS=180
