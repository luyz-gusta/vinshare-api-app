# =============================================================================
# Ford VIN Share API, variáveis de ambiente
# Copie este arquivo para .env e ajuste localmente. NUNCA commitar .env real.
# =============================================================================

# Servidor
SERVER_PORT=8080

# Banco de dados (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/vinshare
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# JWT (gere um segredo aleatório de pelo menos 64 caracteres)
JWT_SECRET=
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7

# CORS (separar por vírgula)
CORS_ORIGINS=http://localhost:8081,exp://localhost:19000

# Criptografia de dados sensíveis (CPF)
CPF_AES_KEY=
CPF_HMAC_KEY=

# Assinatura HMAC de payloads sensíveis
PAYLOAD_SIGNATURE_KEY=

# Integrações externas
GEMINI_API_KEY=
EXPO_ACCESS_TOKEN=

# Política de retenção (deixar vazio/false para desativar)
RETENTION_ENABLED=false
RETENTION_CHAT_DAYS=90
RETENTION_AUDIT_DAYS=180
